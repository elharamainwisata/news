{"message":"Success","data":{"uuid":"N2732899","newswiz_id":"2732899","published_at":1795266044,"tags":[],"main_tag":null,"category":{"id":7,"name":"Tourism and entertainment","is_main":1,"is_followed":false,"is_notify":false},"country":{"id":1,"name":"Saudi Arabia"},"city":{"id":12,"name":"Hail","country_id":1},"default_image_url":null,"locale":"en","title":"Landmark Bus Tours, Folk Arts, and Stargazing Draw Crowds to 'Wasm Hail' Cultural Festival","subtitle":null,"content":"Hail, November 21, 2026, SPA -- The Wasm Hail events at Al-Qishlah Palace in Hail have welcomed thousands of residents and tourists from within the region and beyond to enjoy a diverse array of experiences blending heritage, culture, and entertainment.\n    The program features traditional camel processions, folk arts, stage and musical performances, handicraft stalls, exhibition pavilions, and classic car displays. A dedicated tourist bus service also offers guided tours of landmarks.\n    Adding an educational dimension, the festival includes an astronomical experience enabling visitors to observe the moon and planets through optical telescopes and safely view the sun via specialized solar telescopes, highlighting Hail's diverse cultural and tourism assets.\n    -- SPA\r\n16:00 Local Time 13:00 GMT\r\n0021","hashtags":[],"royal_news_types":[],"date_hijri":"1448-06-11","is_report":false,"related_news":[],"parent_news":null,"report_tasks":[],"translations":[{"uuid":"N2732852","locale":"ar"},{"uuid":"N2733095","locale":"fr"}],"media_images":{"attachment_display":1,"files":[{"id":4607228,"file":{"id":4678406,"uuid":"M11285882","path":"https://portalcdn.spa.gov.sa/backend/original/202611/M11285882.jpg","sizes":["thumbnail","share-img","300-300","400-400"],"original_name":"11285882.jpg","mime_type":"image/jpeg"},"link":null,"is_infographic":0,"is_main":1,"show_in_media":1,"caption":"Landmark Bus Tours, Folk Arts, and Stargazing Draw Crowds to 'Wasm Hail' Cultural Festival","video_thumbnail":null},{