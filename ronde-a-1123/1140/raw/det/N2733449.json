{"message":"Success","data":{"uuid":"N2733449","newswiz_id":"2733449","published_at":1795342090,"tags":[],"main_tag":null,"category":{"id":6,"name":"Cultural","is_main":1,"is_followed":false,"is_notify":false},"country":null,"city":null,"default_image_url":null,"locale":"en","title":"King Khalid University Marks World Television Day","subtitle":null,"content":"Abha, November 22, 2026, SPA -- King Khalid University commemorated World Television Day, observed annually on November 21, by organizing a media exhibition that traced the development of content production and associated equipment, while highlighting the transformations experienced by Saudi television.\n    The exhibition featured a documentary film on the evolution of Saudi television, alongside a display of vintage media equipment and devices that chronicle the progression of television production, offering insight into the technical and professional shifts that have shaped the sector.\n    -- SPA\r\n13:08 Local Time 10:08 GMT\r\n0022","hashtags":[{"id":353,"name":"Media","locale":"en","created_at":"2023-12-13T14:13:12.000000Z","updated_at":"2023-12-13T14:13:12.000000Z"},{"id":8327,"name":"King Khalid University","locale":"en","created_at":"2024-08-27T07:07:12.000000Z","updated_at":"2024-08-27T07:07:12.000000Z"},{"id":41604,"name":"World Television Day","locale":"en","created_at":"2025-11-23T07:54:31.000000Z","updated_at":"2025-11-23T07:54:31.000000Z"}],"royal_news_types":[],"date_hijri":"1448-06-12","is_report":false,"related_news":[],"parent_news":null,"report_tasks":[],"translations":[{"uuid":"N2733360","locale":"ar"},{"uuid":"N2733823","locale":"fr"}],"media_images":{"attachment_display":1,"files":[{"id":4611263,"file":{"id":4682438,"uuid":"M11294085","path":"https://portalcdn.spa.gov.sa/backend/original/202611/M11294085.jpeg","sizes":["thumbnail","share-img","300-300","400-400"],"original_name":"11294085.jpeg","mime_type":"image/jpeg"},"link":null,"is_infographic":0,"is_main":1,"show_in_media":1,"capti