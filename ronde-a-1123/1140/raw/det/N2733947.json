{"message":"Success","data":{"uuid":"N2733947","newswiz_id":"2733947","published_at":1795377912,"tags":[],"main_tag":null,"category":{"id":1,"name":"General","is_main":1,"is_followed":false,"is_notify":false},"country":{"id":1,"name":"Saudi Arabia"},"city":{"id":1,"name":"Riyadh","country_id":1},"default_image_url":null,"locale":"en","title":"Riyadh Region Deputy Governor Attends Omani Embassy Celebration of Oman’s National Day","subtitle":null,"content":"Riyadh, November 22, 2026, SPA -- Deputizing for Governor of Riyadh Region Prince Faisal bin Bandar bin Abdulaziz, Deputy Governor of Riyadh Region Prince Mohammed bin Abdulrahman bin Abdulaziz attended a ceremony hosted by the Embassy of Oman in Saudi Arabia today to mark Oman’s National Day at the InterContinental Hotel Riyadh.\n    Upon his arrival, the deputy governor was received by Omani Ambassador Sayyid Najib bin Hilal bin Saud Albusaidi and several embassy staff members.\n    The ceremony was also attended by Vice Minister of Foreign Affairs Waleed Elkhereiji and several members of the diplomatic corps accredited to the Kingdom.\n    -- SPA\r\n23:05 Local Time 20:05 GMT\r\n0089","hashtags":[{"id":568,"name":"Riyadh","locale":"en","created_at":"2023-12-17T15:25:44.000000Z","updated_at":"2023-12-17T15:25:44.000000Z"}],"royal_news_types":[],"date_hijri":"1448-06-12","is_report":false,"related_news":[],"parent_news":null,"report_tasks":[],"translations":[{"uuid":"N2733860","locale":"ar"},{"uuid":"N2733953","locale":"fa"},{"uuid":"N2733960","locale":"zh"},{"uuid":"N2733961","locale":"fr"}],"media_images":{"attachment_display":1,"files":[{"id":4612472,"file":{"id":4683647,"uuid":"M11296053","path":"https://portalcdn.spa.gov.sa/backend/original/202611/M11296053.jpg","sizes":["thumbnail","share-img","300-300","400-400"],"original_name":"11296053.jpg","mime_type":"image/jpeg"},"link":null,"is_infographic":0,"is_main":1,"show_in_media":1,"caption":"Riyadh Region Deputy Governor Attends Omani Embassy Celebration of O