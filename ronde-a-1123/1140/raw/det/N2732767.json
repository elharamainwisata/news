{"message":"Success","data":{"uuid":"N2732767","newswiz_id":"2732767","published_at":1795239126,"tags":[],"main_tag":null,"category":{"id":6,"name":"Cultural","is_main":1,"is_followed":false,"is_notify":false},"country":{"id":1,"name":"Saudi Arabia"},"city":{"id":10,"name":"Tabuk","country_id":1},"default_image_url":null,"locale":"en","title":"Tabuk Art Exhibition Celebrates International Day of Islamic Art","subtitle":null,"content":"Tabuk, November 21, 2026, SPA -- The Saudi Arabian Society for Culture and Arts in Tabuk hosted a three-day art exhibition marking the International Day of Islamic Art.\n    Organized by a volunteer team in collaboration with the society, the event features works by local artists showcasing the visual richness and civilizational depth of Islamic art by bridging traditional heritage with contemporary perspectives.\n    Divided into four main sections covering Arabic calligraphy, Islamic ornamentation, and contemporary art, the exhibition also includes an interactive workshop enabling visitors to explore Islamic artistic techniques and engage directly with the featured works.\n    -- SPA\r\n08:32 Local Time 05:32 GMT\r\n0011","hashtags":[{"id":41204,"name":"International Day of Islamic Art","locale":"en","created_at":"2025-11-19T06:25:32.000000Z","updated_at":"2025-11-19T06:25:32.000000Z"}],"royal_news_types":[],"date_hijri":"1448-06-11","is_report":false,"related_news":[],"parent_news":null,"report_tasks":[],"translations":[{"uuid":"N2732541","locale":"ar"},{"uuid":"N2733327","locale":"fr"}],"media_images":{"attachment_display":1,"files":[{"id":4606655,"file":{"id":4677833,"uuid":"M11284205","path":"https://portalcdn.spa.gov.sa/backend/original/202611/M11284205.jpeg","sizes":["thumbnail","share-img","300-300","400-400"],"original_name":"11284205.jpeg","mime_type":"image/jpeg"},"link":null,"is_infographic":0,"is_main":1,"show_in_media":1,"caption":"Tabuk Art Exhibition Celebrates International Day of Islamic Art","video_thumbnail":null},