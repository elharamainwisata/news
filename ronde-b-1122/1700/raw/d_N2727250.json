{"message":"Success","data":{"uuid":"N2727250","newswiz_id":"2727250","published_at":1794761477,"tags":[],"main_tag":null,"category":{"id":12,"name":"Science and Technology","is_main":1,"is_followed":false,"is_notify":false},"country":{"id":1,"name":"Saudi Arabia"},"city":{"id":4,"name":"Medina","country_id":1},"default_image_url":null,"locale":"en","title":"Scientific Research Week Kicks Off at Islamic University","subtitle":null,"content":"Madinah, November 15, 2026, SPA -- Scientific Research Week and its accompanying exhibition began today at the Islamic University under the theme \"Scientific Impact and Global Ranking.\" Organized by the university, the five-day event features an exhibition, training workshops, lectures, academic gatherings, and research initiatives.\n    The activities focus on the priorities and future of scientific research while encouraging researchers to participate in academic and training programs.\n    The event aims to showcase the university's key research achievements, encourage researchers to publish academic work and participate in funded research projects and initiatives, and highlight research priorities and strategic goals. It also seeks to explore the future of scientific research at the university to help guide research support programs.\n    -- SPA\r\n19:51 Local Time 16:51 GMT\r\n0063","hashtags":[{"id":4374,"name":"Islamic University","locale":"en","created_at":"2024-04-29T06:57:50.000000Z","updated_at":"2024-04-29T06:57:50.000000Z"},{"id":102872,"name":"Scientific Research Week","locale":"en","created_at":"2026-11-15T16:51:18.000000Z","updated_at":"2026-11-15T16:51:18.000000Z"}],"royal_news_types":[],"date_hijri":"1448-06-05","is_report":false,"related_news":[],"parent_news":null,"report_tasks":[],"translations":[{"uuid":"N2726999","locale":"ar"},{"uuid":"N2727046","locale":"fa"}],"media_images":{"attachment_display":1,"files":[{"id":4587198,"file":{"id":4658373,"uuid":"M11239257","path":"https://portalcdn.spa.gov.sa/backe